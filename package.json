{
  "name": "agentic-physics",
  "version": "0.1.0",
  "description": "Command-line client for Agentic Physics: formalize physics in Lean 4, prove it with a kernel-checked proof, and talk to the agent — from a terminal or from a coding agent such as Claude Code.",
  "type": "module",
  "bin": {
    "agentic-physics": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "skill",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "lean",
    "lean4",
    "physics",
    "physlib",
    "mathlib",
    "theorem-proving",
    "formal-verification",
    "claude-code",
    "cli"
  ],
  "homepage": "https://github.com/Kernel-Science/agentic-physics-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kernel-Science/agentic-physics-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Kernel-Science/agentic-physics-cli/issues"
  },
  "license": "MIT",
  "author": "Kernel Science",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0"
  }
}
